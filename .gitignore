# ---------- Python ----------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.egg

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- IDE / 编辑器 ----------
.idea/
.vscode/
*.swp
*.swo

# ---------- 本地运行中间产物 ----------
# 历史数据缓存（本地生成，不入库）
cache/
# 输出结果（每次运行生成）
results/
*.csv

# ---------- 敏感 / 凭据 ----------
# 允许用户级凭据文件不提交（默认在 %APPDATA%/hithink-finance 下）
.env
.env.*
!*.example
credentials*
*.pem
*.key

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 同花顺本地依赖 ----------
*.dll
*.so
*.dylib
